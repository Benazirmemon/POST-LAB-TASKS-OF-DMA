#include<stdio.h>
#include<stdlib.h>
int main(){
    int *id;
    int *salaries;
    int n,total=0,avg;
    printf("enter the no of employes");
    scanf("%d",&n);
    id=(int*)calloc(n,sizeof(int));
    salaries=(int*)calloc(n,sizeof(int));
    if(id==NULL && salaries==NULL){
        printf("memory allocation failed");
    }
    else{
        printf("memory allocation successfully\n");
        for(int i=0;i<n;i++){
            printf("employee %d\n",i+1);
            printf("enter the employee id");
            scanf("%d",&id[i]);
            printf("enter the employee salary");
            scanf("%d",&salaries[i]);
        }
         for(int i=0;i<n;i++){
             printf("employee id %d\n employee salaries %d\n",id[i],salaries[i]);
             total+=salaries[i];
         }
        avg=total/n;
       
        printf("total %d\n",total);
        printf("avg %d\n",avg);
        free(id);
        free(salaries);
    }
}
